# Environment Configuration for Life System
PORT=8000
HOST=127.0.0.1

# SQLite default database path (or PostgreSQL connection string: postgresql://user:password@localhost:5432/lifesystem)
DATABASE_URL=sqlite:///./lifesystem.db

# Allowed CORS origins (comma-separated for custom domain)
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173,http://localhost:8000

# Required for all personal-data API routes, including through the tunnel.
# Generate with: .venv/bin/python backend/create_login.py
LOCK_IN_PASSWORD_HASH=
LOCK_IN_SESSION_SECRET=

# Optional Ask Lock In integration. Keep the key on the server only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 24/7 Persistent Cloudflare Tunnel (Optional, but recommended for permanent 24/7 domain)
# Create a free tunnel in Cloudflare Zero Trust (Networks -> Tunnels) and paste token here:
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
# CUSTOM_DOMAIN=life.yourdomain.com
